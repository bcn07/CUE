# Copy to .env and fill in. Keys are never printed or committed.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Interpreter (structured output). Fast, cheap, vision-capable default.
CUE_LLM_MODEL=gpt-4.1-mini
CUE_LLM_TIMEOUT_S=3.0
# Rule-based fast path cuts ~0 ms after the clause when the pattern is unambiguous; LLM follows.
CUE_FAST_PATH=1

# Vision-language fallback when the local face match cannot confirm anyone (needs OPENAI key).
CUE_VLM=1
CUE_VLM_MODEL=gpt-4.1-mini
CUE_VLM_MIN_INTERVAL_S=4.0

# Speech
CUE_DEEPGRAM_MODEL=nova-3
# CUE_DEEPGRAM_MODEL=flux-general-en   # Deepgram's turn-based model (v2 endpoint): one final per turn, split into sentences here
# CUE_FLUX_EOT_THRESHOLD=0.7           # end-of-turn confidence (0.5-0.9); lower = sooner, riskier
# CUE_FLUX_EOT_TIMEOUT_MS=3000         # silence that ends a turn regardless
# CUE_MIC_DEVICE=1           # index or name from tools/smoke_keys.py (e.g. 1 = MacBook Pro Microphone); default = system input

# Directing tunables (seconds)
CUE_MIN_SHOT_S=2.5
CUE_CUE_LIFETIME_S=3.0
CUE_IDENTITY_MAX_AGE_S=4.0
CUE_CAMERA_STALE_S=1.5
CUE_IDENT_INTERVAL_S=0.15
CUE_PORT=8000

# Recording (REC button / POST /api/record). Program video + master audio + cut log under data/recordings/.
CUE_RECORD_FPS=15
CUE_RECORD_SIZE=640x360
CUE_AUTO_RECORD=0
CUE_RECORD_AUDIO=1

# Open-source LLM instead of OpenAI: run `ollama serve`, `ollama pull qwen2.5:3b`, then set:
# CUE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CUE_LLM_MODEL=qwen2.5:3b
# CUE_LLM_TIMEOUT_S=6

# Team GUI bridge: mirror every cut to the team backend (apps/api) so the team's React GUI cuts its LiveKit video.
# Start the team API on another port than this server (e.g. team on 8000, this on 8001 via CUE_PORT).
# CUE_TEAM_API=http://127.0.0.1:8000
# CUE_TEAM_EVENT_ID=demo-night
# CUE_TEAM_PRODUCER_SECRET=            # defaults to CUE_PRODUCER_SECRET from the team repo's .env
# CUE_TEAM_CAMERA_MAP=A=CAM-WIDE,B=CAM-GUEST,C=CAM-HOST
# CUE_TEAM_RESUME_MODE=ASSIST       # ASSIST: suggestions the operator confirms (default). AUTO: cuts on air (team decision).

# --- LiveKit Cloud video transport (optional). When all three are set, the phone page publishes WebRTC
# to this room and the director subscribes there; laptops on /ingest keep working alongside.
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ROOM=cue-oneshot
# CUE_LIVEKIT_FPS=10            # JPEG re-encode rate per camera into identity/observers/recorder
# CUE_LIVEKIT_MAX_WIDTH=960

# --- Sheet sign-ups (optional). Guests who sign up on the desk pages' signup.html enrol themselves here:
# name, role and both photos, plus the camera the dashboard assigns. When unset, the endpoint is read from
# server/static/config.js (the same file the pages use). It is a capability URL: anyone holding it can write
# to the sheet. Never commit it, never paste it in chat.
# CUE_SIGNUP_ENDPOINT=https://script.google.com/macros/s/<id>/exec
# CUE_SIGNUP_EVENT_ID=hackmit-demo   # only rows written with this eventId (config.js eventId); empty = every row
# CUE_SIGNUP_POLL_S=5

# --- Scene tags (optional, OFF by default: a second 3B model in RAM; on a 16 GB Mac Ollama died once with three models
# loaded, which also takes the cue interpreter down). A local vision model describes what
# each camera sees, slowly, in the background; "let's look at the flowers" then cuts to the camera whose tags show
# flowers, "let's look at the audience" to the one showing a crowd (an operator's audience/demo role still wins).
# CUE_SCENE=1                         # turn it on
# CUE_SCENE_MODEL=qwen2.5vl:3b        # `ollama pull qwen2.5vl:3b`; answers in JSON, ~12-30 s per frame on an M-series Mac
# CUE_SCENE_BASE_URL=                 # defaults to CUE_LLM_BASE_URL (Ollama's OpenAI-compatible endpoint)
# CUE_SCENE_INTERVAL_S=20             # one camera per interval; never while a cue is pending
# CUE_SCENE_MAX_AGE_S=600             # tags older than this are ignored
