# Copy to .env and fill in. Keys are never printed or committed.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Interpreter (structured output). Fast, cheap, vision-capable default.
CUE_LLM_MODEL=gpt-4.1-mini
CUE_LLM_TIMEOUT_S=3.0
# Rule-based fast path cuts ~0 ms after the clause when the pattern is unambiguous; LLM follows.
CUE_FAST_PATH=1

# Vision-language fallback when the local face match cannot confirm anyone (needs OPENAI key).
CUE_VLM=1
CUE_VLM_MODEL=gpt-4.1-mini
CUE_VLM_MIN_INTERVAL_S=4.0

# Speech
CUE_DEEPGRAM_MODEL=nova-3
# CUE_MIC_DEVICE=1           # index or name from tools/smoke_keys.py (e.g. 1 = MacBook Pro Microphone); default = system input

# Directing tunables (seconds)
CUE_MIN_SHOT_S=2.5
CUE_CUE_LIFETIME_S=3.0
CUE_IDENTITY_MAX_AGE_S=4.0
CUE_CAMERA_STALE_S=1.5
CUE_IDENT_INTERVAL_S=0.15
CUE_PORT=8000

# Recording (REC button / POST /api/record). Program video + master audio + cut log under data/recordings/.
CUE_RECORD_FPS=15
CUE_RECORD_SIZE=640x360
CUE_AUTO_RECORD=0
CUE_RECORD_AUDIO=1

# Open-source LLM instead of OpenAI: run `ollama serve`, `ollama pull qwen2.5:3b`, then set:
# CUE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CUE_LLM_MODEL=qwen2.5:3b
# CUE_LLM_TIMEOUT_S=6

# Team GUI bridge: mirror every cut to the team backend (apps/api) so the team's React GUI cuts its LiveKit video.
# Start the team API on another port than this server (e.g. team on 8000, this on 8001 via CUE_PORT).
# CUE_TEAM_API=http://127.0.0.1:8000
# CUE_TEAM_EVENT_ID=demo-night
# CUE_TEAM_PRODUCER_SECRET=            # defaults to CUE_PRODUCER_SECRET from the team repo's .env
# CUE_TEAM_CAMERA_MAP=A=CAM-WIDE,B=CAM-GUEST,C=CAM-HOST
# CUE_TEAM_RESUME_MODE=ASSIST       # ASSIST: suggestions the operator confirms (default). AUTO: cuts on air (team decision).
